# Copy this file to .env (or set the variables in your shell). No keys = mock mode.
# Which decision model to use: mock | typesafe | foundry | openai
DECISION_PROVIDER=mock

# TypeSafe Jev  (https://docs.typesafe.ai/introduction/quickstart)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Microsoft-Decision-1 in Microsoft Foundry
# (https://learn.microsoft.com/azure/foundry/foundry-models/how-to/use-foundry-models-microsoft-decision)
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=

# OpenAI Decisions API  (https://developers.openai.com/api/docs/guides/decisions)
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna

# Generative LLM baseline: any OpenAI-compatible /chat/completions endpoint
# (OpenAI, OpenRouter, Azure OpenAI, Ollama, LM Studio ...). Empty = simulated baseline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
