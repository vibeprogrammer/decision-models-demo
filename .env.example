# Copy this file to .env (git-ignored) or set the variables in your shell. No keys = mock mode for `npm run demo`.
#   PowerShell: Copy-Item .env.example .env    cmd: copy .env.example .env    macOS/Linux: cp .env.example .env
# Which decision model `npm run demo` uses: mock | azure | typesafe | openai
# (`npm run demo:azure` always uses azure, and falls back to mock if the key is missing)
DECISION_PROVIDER=mock

# Microsoft-Decision-1 in Microsoft Foundry (Azure)
# Docs: https://learn.microsoft.com/azure/foundry/foundry-models/how-to/use-foundry-models-microsoft-decision
# Endpoint: full decision URL or just the resource URL, both work.
AZURE_DECISION_ENDPOINT=https://proj-middagskos-resource.services.ai.azure.com/providers/microsoft/v1/systemone
# API key from the deployment details page (Foundry portal) or Keys and Endpoint (Azure portal). Never commit it.
AZURE_DECISION_KEY=
# Deployment name (NOT the model name). Default: Microsoft-Decision-1. Maxim's deployment: dep-decision-1
AZURE_DECISION_DEPLOYMENT=dep-decision-1
# Optional instead of the key: Microsoft Entra ID token (az account get-access-token --resource https://cognitiveservices.azure.com)
AZURE_DECISION_TOKEN=

# TypeSafe Jev  (https://docs.typesafe.ai/introduction/quickstart)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenAI Decisions API  (https://developers.openai.com/api/docs/guides/decisions)
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna

# The regular LLM for `compare:azure` and the web demo: GPT-6 Luna on the same Foundry resource.
# Uses AZURE_DECISION_ENDPOINT's resource and AZURE_DECISION_KEY unless you set the two below.
AZURE_LLM_DEPLOYMENT=dep-gpt-6-luna
AZURE_LLM_ENDPOINT=
AZURE_LLM_KEY=
# Hard cap on the LLM's output tokens per call (default 300) and its reasoning effort (default none)
LLM_MAX_OUTPUT_TOKENS=300
LLM_REASONING_EFFORT=none

# Or any other OpenAI-compatible /chat/completions endpoint (OpenAI, OpenRouter, Ollama, LM Studio ...).
# Setting LLM_BASE_URL takes precedence over AZURE_LLM_*. LLM_AUTH=api-key sends an "api-key" header.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_AUTH=
